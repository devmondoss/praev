{
  "name": "praev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "contract:test": "cargo test --manifest-path contracts/Cargo.toml",
    "contract:build": "cd contracts && stellar contract build"
  },
  "dependencies": {
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
