# Copy to .env.local. Never commit real values.
# Postgres: Neon pooled URL for the app, unpooled (direct) URL for migrations.
# Local Docker alternative: postgres://praev:local_only_change_me@127.0.0.1:5432/praev
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Stellar (testnet only)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_PRAEV_CONTRACT_ID=
PRAEV_DEPLOYMENT_ID=

# Operational accounts (public addresses only; secrets stay in the Stellar CLI keystore)
PRAEV_CURATOR_ADDRESS=
PRAEV_RESOLVER_ADDRESS=
PRAEV_AGENT_ADDRESS=

# AI agent via OpenRouter (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
